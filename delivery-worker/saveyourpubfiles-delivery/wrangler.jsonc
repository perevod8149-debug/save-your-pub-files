{
  "name": "saveyourpubfiles-delivery",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-11",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "saveyourpubfiles-downloads"
    }
  ],
  "kv_namespaces": [
    {
      "id": "c07382e0a39940688bdc27f47f12a4c7",
      "binding": "PURCHASES"
    }
  ]
}